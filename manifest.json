{
  "manifest_version": 3,
  "name": "SponsoredGone",
  "version": "1.0.0",
  "description": "Instantly hides sponsored results on Google Search. One switch, no tracking.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://www.google.com/*",
    "https://google.com/*",
    "https://maps.google.com/*",
    "https://www.google.az/*",
    "https://google.az/*",
    "https://maps.google.az/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "SponsoredGone: ON",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
